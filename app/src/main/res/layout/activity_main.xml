<?xml version="1.0" encoding="utf-8"?>
<!-- 手机端紧凑采集界面：播放器优先展示，单屏串联采集、测试与保存。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="#FF000000">

            <!-- TextureView 的 Surface 只通过 ProbePlayer 公共门面附加。 -->
            <TextureView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:keepScreenOn="true" />

            <!-- 播放器时间标识保持透明，拖动进度时持续显示当前位置和总时长。 -->
            <TextView
                android:id="@+id/playerTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="42dp"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="00:00 / --:--"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/playbackSeekBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/playback_seek"
                android:enabled="false"
                android:max="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:progressDrawable="@drawable/playback_seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/playback_seek_thumb" />

            <LinearLayout
                android:id="@+id/testOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/testOverlayMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:shadowColor="#FF000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/skipAdButton"
                    style="@style/CompactActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:minWidth="132dp"
                    android:text="@string/skip_ad"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/urlInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/link_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/helpButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/help"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_help" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/playButton"
                    style="@style/CompactActionButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/play" />

                <Button
                    android:id="@+id/autoScanButton"
                    style="@style/CompactActionButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/auto_scan" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CompactFieldLabel"
                    android:text="@string/start_position" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/time_stepper_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/startTimeMinus"
                        style="@style/CompactStepperButton"
                        android:enabled="false"
                        android:text="−" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/startMinuteText"
                            style="@style/PositionComponentInput"
                            android:imeOptions="actionNext"
                            android:maxLength="3" />

                        <TextView
                            style="@style/TimeSeparatorText"
                            android:text=":" />

                        <EditText
                            android:id="@+id/startSecondText"
                            style="@style/PositionComponentInput"
                            android:imeOptions="actionNext"
                            android:maxLength="2" />

                        <TextView
                            style="@style/TimeSeparatorText"
                            android:text="." />

                        <EditText
                            android:id="@+id/startCentisecondText"
                            style="@style/PositionComponentInput"
                            android:imeOptions="actionDone"
                            android:maxLength="2" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/startTimePlus"
                        style="@style/CompactStepperButton"
                        android:enabled="false"
                        android:text="+" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/startPreviewButton"
                    style="@style/CompactPreviewButton"
                    android:contentDescription="@string/preview_start"
                    android:enabled="false"
                    android:src="@android:drawable/ic_media_play" />

                <Button
                    android:id="@+id/useCurrentPositionButton"
                    style="@style/CompactActionButton"
                    android:layout_width="82dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:enabled="false"
                    android:text="@string/use_current_position"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CompactFieldLabel"
                    android:text="@string/end_position" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/time_stepper_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/endTimeMinus"
                        style="@style/CompactStepperButton"
                        android:enabled="false"
                        android:text="−" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/endMinuteText"
                            style="@style/PositionComponentInput"
                            android:imeOptions="actionNext"
                            android:maxLength="3" />

                        <TextView
                            style="@style/TimeSeparatorText"
                            android:text=":" />

                        <EditText
                            android:id="@+id/endSecondText"
                            style="@style/PositionComponentInput"
                            android:imeOptions="actionNext"
                            android:maxLength="2" />

                        <TextView
                            style="@style/TimeSeparatorText"
                            android:text="." />

                        <EditText
                            android:id="@+id/endCentisecondText"
                            style="@style/PositionComponentInput"
                            android:imeOptions="actionDone"
                            android:maxLength="2" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/endTimePlus"
                        style="@style/CompactStepperButton"
                        android:enabled="false"
                        android:text="+" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/endPreviewButton"
                    style="@style/CompactPreviewButton"
                    android:contentDescription="@string/preview_end"
                    android:enabled="false"
                    android:src="@android:drawable/ic_media_play" />

                <Button
                    android:id="@+id/useCurrentEndPositionButton"
                    style="@style/CompactActionButton"
                    android:layout_width="82dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:enabled="false"
                    android:text="@string/use_current_position"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CompactFieldLabel"
                    android:text="@string/ad_duration" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/time_stepper_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/durationMinus"
                        style="@style/CompactStepperButton"
                        android:enabled="false"
                        android:text="−" />

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/durationMinuteInput"
                            style="@style/DurationComponentInput"
                            android:imeOptions="actionNext"
                            android:maxLength="3" />

                        <TextView
                            style="@style/TimeSeparatorText"
                            android:text=":" />

                        <EditText
                            android:id="@+id/durationSecondInput"
                            style="@style/DurationComponentInput"
                            android:imeOptions="actionNext"
                            android:maxLength="2" />

                        <TextView
                            style="@style/TimeSeparatorText"
                            android:text="." />

                        <EditText
                            android:id="@+id/durationCentisecondInput"
                            style="@style/DurationComponentInput"
                            android:imeOptions="actionDone"
                            android:maxLength="2" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/durationPlus"
                        style="@style/CompactStepperButton"
                        android:enabled="false"
                        android:text="+" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/durationPreviewButton"
                    style="@style/CompactPreviewButton"
                    android:contentDescription="@string/preview_duration"
                    android:enabled="false"
                    android:src="@android:drawable/ic_media_play" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/extractButton"
                    style="@style/CompactActionButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/extract_fingerprint" />

                <Button
                    android:id="@+id/testButton"
                    style="@style/CompactActionButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/test_rule" />

                <Button
                    android:id="@+id/confirmButton"
                    style="@style/CompactActionButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/confirm_rule" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/autoSkipCheckBox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:padding="0dp"
                    android:text="@string/test_auto_skip_short"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/confirmedRuleCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical|end"
                    android:textColor="@color/confirmed_success"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/savedRulesButton"
                    style="@style/CompactActionButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/saved_rule_list" />

                <Button
                    android:id="@+id/mergeRulesButton"
                    style="@style/CompactActionButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/merge_rules" />
            </LinearLayout>

            <TextView
                android:id="@+id/rulePathText"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:ellipsize="middle"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/ruleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="3"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:text="@string/ready"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
